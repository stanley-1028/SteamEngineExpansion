<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SEE offline balance + performance simulator (P7 scope; PLAN_SEE §3 SEE-P7,
    requirements §5.5 / §12.6 / §13.7 / §14.7 / §17.3).

    Net9.0 console with zero NuGet packages (offline build rule) that reads
    data/engines.json + data/engines.derived.json and drives the SAME formulas the mod
    ships: ProjectReference to SEE.Core (BoilerFormulas, ConditionCurve, BoilerStateMachine).
    The tool is build-time evidence only; it is never loaded by the game and not shipped.

        dotnet run (project mod/tools/balance-sim, config Release, -m:1)

    Exit code 0 = all four §5.2 balance criteria pass; any FAIL = non-zero.
    The tool never writes to the workspace: the deliverables are docs/BALANCE_REPORT.md
    and docs/PERF_BUDGET.md, filled from this command's output.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>SeeBalanceSim</AssemblyName>
    <RootNamespace>SEE.Tools.BalanceSim</RootNamespace>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SEE.Core\SEE.Core.csproj" />
  </ItemGroup>

</Project>
