    "description": {
      "enUS": "Consumes fuel and water to produce power. Requires periodic maintenance.",
      "zhTW": "消耗燃料與水產生動能。需定期維護。",
      "zhCN": "消耗燃料与水产生动力。需要定期维护。"
    },
    "toolGroup": {
      "enUS": "Steam Engines",
      "zhTW": "蒸汽引擎",
      "zhCN": "蒸汽引擎"
    },
    "flavor": {
      "T1": {
        "enUS": "A humble boiler that asks for a little wood and a little water.",
        "zhTW": "謙卑的小鍋爐，只要一點木頭和一點水。",
        "zhCN": "谦卑的小锅炉，只要一点木头和一点水。"
      },
      "T2": {
        "enUS": "Pressure, timber and brass—now with a gauge.",
        "zhTW": "壓力、木材與黃銅——現在還多了壓力錶。",
        "zhCN": "压力、木材与黄铜——现在还多了压力表。"
      },
      "T3": {
        "enUS": "Cast iron rumbles; rivets hold the promise of power.",
        "zhTW": "鑄鐵低鳴，鉚釘撐起動能的承諾。",
        "zhCN": "铸铁低鸣，铆钉撑起动力的承诺。"
      },
      "T4": {
        "enUS": "Precision in every valve, and a price in every turn.",
        "zhTW": "每個閥門都精準，每一轉都有代價。",
        "zhCN": "每个阀门都精准，每一转都有代价。"
      }
    },
